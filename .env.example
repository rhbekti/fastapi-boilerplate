# PostgreSQL credentials — digunakan oleh service db, api, dan migrate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=db_fastapi

# DATABASE_URL tidak perlu diisi manual — di-generate otomatis dari variable di atas.
# Tapi jika pakai external DB, isi ini dan hapus service db dari compose:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
